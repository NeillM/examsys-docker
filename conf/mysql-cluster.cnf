[ndbd default]
NoOfReplicas=2
DataMemory=80M
IndexMemory=18M
MaxNoOfAttributes=2500
MaxNoOfOrderedIndexes=512
MaxNoOfTables=400
MaxNoOfUniqueHashIndexes=200
MaxNoOfTriggers=1500
MaxNoOfConcurrentOperations=60000
MaxNoOfConcurrentTransactions=10000
[ndb_mgmd]
NodeId=1
hostname=192.168.0.2
datadir=/var/lib/mysql
[ndbd]
NodeId=2
hostname=192.168.0.3
datadir=/var/lib/mysql
[ndbd]
NodeId=3
hostname=192.168.0.4
datadir=/var/lib/mysql
[mysqld]
NodeId=4
hostname=192.168.0.10
